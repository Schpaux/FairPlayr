# FairPlayr environment example
# Copy values into .env.local for local development.

# Required for Vertex AI server-side integration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# EU only (SEC-10, docs/ai-vertex-setup.md); the code never switches region.
VERTEX_AI_LOCATION=europe-west3
VERTEX_AI_MODEL=gemini-2.5-flash

# Optional but recommended for internal AI health endpoint in production
AI_HEALTHCHECK_TOKEN=replace-with-random-token
