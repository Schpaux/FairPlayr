{
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run verify)",
      "Bash(npx vitest run *)",
      "Bash(npx playwright test *)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git tag *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(gh pr *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(npm run cap:sync)",
      "Bash(npm run cap:sync:prod)",
      "Bash(npm run cap:build)",
      "Bash(npx cap sync *)",
      "Bash(npx cap sync)",
      "Bash(git commit)",
      "Bash(git merge *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git config core.hooksPath*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * -f *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(psql*)",
      "Bash(pg_dump*)",
      "Bash(pg_restore*)",
      "Bash(npm run cap:*)",
      "Bash(npx cap *)",
      "Bash(FP_GIT_APPROVED=*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)"
    ],
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.production)",
      "Read(/**/.env.development)",
      "Read(/**/.env.test)",
      "Read(/**/.env.staging)",
      "Read(/**/.env.preview)",
      "Read(/**/.envrc)",
      "Read(/**/supabase/.temp/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.p8)",
      "Read(/**/*.p12)",
      "Read(/**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/fp-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-git-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
