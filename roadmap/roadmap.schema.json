{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairplayr.app/roadmap.schema.json",
  "title": "FairPlayr roadmap",
  "description": "Structure of roadmap/roadmap.json. Cross-field rules (decision/status combinations, parents, cycles, date order, commit existence) are enforced by scripts/roadmap/lib.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "updated": { "$ref": "#/$defs/day" },
    "description": { "type": "string" },
    "missing_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "note"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[-.][A-Za-z0-9]+)*$" },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD. Use the least precise form that is documented."
    },
    "text": { "type": "string", "minLength": 1 },
    "localeText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {
          "enum": ["commit", "migration", "doc", "local_doc", "legacy_todo", "review_patch", "owner_decision", "url"],
          "description": "commit: hash on main. migration/doc: versioned file. local_doc/review_patch: untracked file in the owner's checkout. legacy_todo: the archived TODO.md. owner_decision: a decision by the product owner. url: external page."
        },
        "ref": { "$ref": "#/$defs/text" },
        "note": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "summary", "category", "decision", "status", "origin", "sources", "updated"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "Stable, never reused. Legacy TODO ids are kept as they were." },
        "type": { "enum": ["initiative", "feature", "task", "bug", "chore"] },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text", "description": "Internal description." },
        "rationale": { "type": "string", "description": "User problem or reason the item exists." },
        "category": {
          "enum": ["match-live", "substitutions", "playing-time", "setup", "team", "history", "sharing", "ai", "spond", "offline-sync", "design-ui", "accessibility", "settings", "platform", "security-privacy", "devex", "process", "website"]
        },
        "parent": { "$ref": "#/$defs/id", "description": "feature → initiative; task/bug/chore → initiative or feature; omitted for stand-alone fixes." },
        "work_order": { "type": "integer", "minimum": 1, "description": "Product owner's work order for initiatives." },
        "decision": {
          "enum": ["completed", "committed", "considering", "deferred", "rejected"],
          "description": "Product decision. Only the product owner moves an item from considering to committed."
        },
        "status": {
          "enum": ["not_started", "in_progress", "in_review", "implemented", "released", "needs_verification"],
          "description": "Implementation status. released = in production (documented deploy or contained in a later documented deploy)."
        },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "origin": {
          "enum": ["documented_implementation", "owner_decision", "legacy_todo", "user_feedback", "competitor_finding", "claude_proposal"]
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": { "$ref": "#/$defs/date" },
            "started": { "$ref": "#/$defs/date", "description": "First commit." },
            "implemented": { "$ref": "#/$defs/date", "description": "Last commit on main that completed it." },
            "released": { "$ref": "#/$defs/date", "description": "Documented production deploy." },
            "released_no_later_than": { "$ref": "#/$defs/date", "description": "No deploy record, but contained in a later documented deploy." },
            "verified": { "$ref": "#/$defs/date" }
          }
        },
        "verification": {
          "enum": ["production", "partial", "none", "not_applicable"],
          "description": "How completed work was checked: production = documented production check of the feature itself."
        },
        "release": { "type": "string", "description": "Version or release name, only when documented." },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/id" }, "description": "Ids merged into this item." },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "superseded_by": { "$ref": "#/$defs/id" },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "no", "en"],
          "properties": {
            "visible": { "type": "boolean" },
            "milestone": { "type": "boolean", "description": "Major public milestone on the timeline." },
            "no": { "$ref": "#/$defs/localeText" },
            "en": { "$ref": "#/$defs/localeText" }
          }
        },
        "uncertainty": { "type": "string", "description": "What is not documented or needs verification." },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "changelog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "note"],
            "properties": { "date": { "$ref": "#/$defs/day" }, "note": { "$ref": "#/$defs/text" } }
          }
        },
        "updated": { "$ref": "#/$defs/day" }
      }
    }
  }
}
