{
  "name": "fairplayr-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "test:e2e": "playwright test",
    "test:e2e:quick": "playwright test --project=iphone-se-375x667",
    "test:e2e:offline": "playwright test -c playwright.offline.config.ts",
    "test:e2e:live": "playwright test e2e/live-sideline.spec.ts e2e/live-navigation.spec.ts e2e/half-transition.spec.ts --project=iphone-se-375x667",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run test:e2e",
    "cap:sync": "cap sync",
    "cap:sync:dev": "CAPACITOR_SERVER_URL=http://localhost:3000 cap sync",
    "cap:sync:prod": "cap sync",
    "cap:ios": "cap open ios",
    "cap:build": "npm run build && cap sync"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.5.3",
